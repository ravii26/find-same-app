# Secrets: never commit real credentials. An example file may be committed as .env.example.
.env
.env.*
!.env.example

# Python virtualenv and bytecode
.venv*/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Build output
build/
dist/

# Runtime data: brand records, scan reports, logs, uploads
data/
uploads/
*.log

# Local generated results
indus_appstore_results.json

# Editors and OS files
.DS_Store
.idea/
.vscode/

# Local Claude Code settings (shared settings in .claude/settings.json stay tracked)
.claude/settings.local.json

docs/